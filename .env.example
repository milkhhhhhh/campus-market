# ==============================================================
# campus-market 环境变量样例
# 复制为 apps/server/.env.local 或 packages/db/.env 后按需填写
# ==============================================================

# 本地开发（SQLite）
DATABASE_URL="file:./dev.db"

# 生产（PostgreSQL）示例：
# DATABASE_URL="postgresql://campus:campus@localhost:5432/campus_market?schema=public"
# 切换 Postgres 时需将 packages/db/prisma/schema.prisma 的 provider 改为 postgresql 并重新 migrate

# JWT 签名密钥（至少 32 字符）
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32"

# 网站对外域名（SEO sitemap / OG / 深链）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 静态资源 / 上传文件的基础访问地址
# - 仅本机浏览器：可用 http://localhost:3000/uploads
# - 手机 App / 真机调试：请改为 http://<电脑局域网IP>:3000/uploads
#   若仍写 localhost，服务端会按请求 Host 自动改写（推荐）
UPLOAD_BASE_URL="http://localhost:3000/uploads"
# 强制始终按请求 Host 生成上传 URL（局域网联调可开）
# UPLOAD_RESOLVE_FROM_REQUEST="true"
UPLOAD_STORAGE="local"
UPLOAD_MAX_FILE_SIZE="5242880"
UPLOAD_MAX_FILES="9"
# UPLOAD_LOCAL_ROOT_DIR=

# Capacitor App 加载的网站地址（构建/sync 时注入）
# 开发：http://<电脑局域网IP>:3000
# 生产：https://你的域名
# CAPACITOR_SERVER_URL="http://192.168.0.104:3000"
