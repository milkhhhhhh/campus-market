# Copy this file to .env.local before starting @campus/server.
# Never commit real credentials or secrets.

# Prisma resolves this SQLite URL relative to packages/db/prisma/schema.prisma.
# PostgreSQL example:
# postgresql://user:password@localhost:5432/campus_market?schema=public
DATABASE_URL="file:./dev.db"

# Use at least 32 random bytes outside local development.
JWT_SECRET="replace-with-at-least-32-random-characters"

# Public base URL for uploaded/static files.
UPLOAD_BASE_URL="http://localhost:3000/uploads"

# Storage backend: local (disk) or oss (not implemented yet).
UPLOAD_STORAGE="local"

# Max single file size in bytes (default 5MB).
UPLOAD_MAX_FILE_SIZE="5242880"

# Max files per upload request (matches listing image limit).
UPLOAD_MAX_FILES="9"

# Admin session cookie max age in seconds (default 7 days).
ADMIN_SESSION_MAX_AGE="604800"

# Public site origin for sitemap / Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
