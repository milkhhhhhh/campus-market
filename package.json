{
  "name": "campus-market",
  "version": "0.1.0",
  "private": true,
  "description": "校园二手交易与闲置租借平台 (monorepo)",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/mobile"
  ],
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "scripts": {
    "db:generate": "npm run generate --workspace @campus/db",
    "db:migrate": "npm run migrate --workspace @campus/db",
    "db:dev": "npm run dev --workspace @campus/db",
    "dev:server": "npm run dev --workspace @campus/server",
    "mobile:sync": "npm run sync --workspace @campus/mobile",
    "mobile:android": "npm run android --workspace @campus/mobile",
    "mobile:ios": "npm run ios --workspace @campus/mobile",
    "test": "npm run test --workspace=@campus/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}
